{
	"name": "remix-data-kit",
	"version": "0.17.0",
	"description": "a kit to simplify handling form submissions in remix",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/smeijer/remix-data-kit.git"
	},
	"funding": "https://github.com/smeijer/remix-data-kit?sponsor=1",
	"author": "Stephan Meijer <stephan.meijer@gmail.com> (meijer.ws)",
	"bugs": "https://github.com/smeijer/remix-data-kit/issues",
	"homepage": "https://github.com/smeijer/remix-data-kit#readme",
	"main": "./dist/commonjs/index.js",
	"module": "./dist/esm/index.js",
	"types": "./dist/commonjs/index.d.ts",
	"bin": {
		"remix-data-kit": "./dist/esm/cli.mjs"
	},
	"type": "module",
	"engines": {
		"node": ">=18"
	},
	"tshy": {
		"exclude": [
			"src/**/*.test.ts"
		],
		"exports": [
			"./src/*.ts"
		]
	},
	"scripts": {
		"build": "tshy && tsx scripts/fix-exports.ts && tsx scripts/fix-node10.ts && attw -P",
		"prepare": "npx simple-git-hooks",
		"lint": "eslint --fix .",
		"type-check": "tsc --noEmit",
		"test": "borp"
	},
	"simple-git-hooks": {
		"pre-commit": "pretty-quick --staged"
	},
	"files": [
		"dist",
		"license",
		"/actions.test/package.json",
		"/actions/package.json",
		"/assert.test/package.json",
		"/assert/package.json",
		"/register/package.json",
		"/stream/package.json",
		"/unwrap/package.json"
	],
	"keywords": [
		"formdata",
		"parse",
		"stringify",
		"expand"
	],
	"devDependencies": {
		"@arethetypeswrong/cli": "^0.15.3",
		"@remix-run/node": "^2.9.2",
		"@remix-run/server-runtime": "^2.9.1",
		"@sinclair/typebox": "^0.32.0",
		"@smeijer/eslint-config": "^1.5.0",
		"@smeijer/tsconfig": "^1.0.0",
		"@types/node": "^18.19.31",
		"@types/yargs": "^17.0.32",
		"borp": "^0.13.0",
		"eslint-plugin-best-practices": "^0.0.1",
		"pretty-quick": "^4.0.0",
		"simple-git-hooks": "^2.11.1",
		"tshy": "^3.0.2",
		"tsx": "^4.9.3",
		"typescript": "^5.4.5",
		"unbuild": "^2.0.0"
	},
	"peerDependencies": {
		"@remix-run/node": "^2.0.0 || ^3.0.0",
		"@remix-run/server-runtime": "^2.0.0 || ^3.0.0",
		"@sinclair/typebox": "^0.32.0",
		"prettier": "^2 || ^3"
	},
	"dependencies": {
		"@types/busboy": "^1.5.4",
		"@types/bytes": "^3.1.4",
		"busboy": "^1.6.0",
		"bytes": "^3.1.2",
		"form-data-kit": "^1.1.0",
		"glob": "^10.3.12",
		"listr2": "^8.2.1",
		"picocolors": "^1.0.0",
		"picoid": "^1.2.0",
		"schema2typebox": "^1.7.4",
		"ts-morph": "^23.0.0",
		"typebox-assert": "^0.5.0",
		"yargs": "^17.7.2"
	},
	"exports": {
		"./actions": {
			"import": {
				"types": "./dist/esm/actions.d.ts",
				"default": "./dist/esm/actions.js"
			},
			"require": {
				"types": "./dist/commonjs/actions.d.ts",
				"default": "./dist/commonjs/actions.js"
			}
		},
		"./assert": {
			"import": {
				"types": "./dist/esm/assert.d.ts",
				"default": "./dist/esm/assert.js"
			},
			"require": {
				"types": "./dist/commonjs/assert.d.ts",
				"default": "./dist/commonjs/assert.js"
			}
		},
		".": {
			"import": {
				"types": "./dist/esm/index.d.ts",
				"default": "./dist/esm/index.js"
			},
			"require": {
				"types": "./dist/commonjs/index.d.ts",
				"default": "./dist/commonjs/index.js"
			}
		},
		"./register": {
			"import": {
				"types": "./dist/esm/register.d.ts",
				"default": "./dist/esm/register.js"
			},
			"require": {
				"types": "./dist/commonjs/register.d.ts",
				"default": "./dist/commonjs/register.js"
			}
		},
		"./stream": {
			"import": {
				"types": "./dist/esm/stream.d.ts",
				"default": "./dist/esm/stream.js"
			},
			"require": {
				"types": "./dist/commonjs/stream.d.ts",
				"default": "./dist/commonjs/stream.js"
			}
		},
		"./unwrap": {
			"import": {
				"types": "./dist/esm/unwrap.d.ts",
				"default": "./dist/esm/unwrap.js"
			},
			"require": {
				"types": "./dist/commonjs/unwrap.d.ts",
				"default": "./dist/commonjs/unwrap.js"
			}
		},
		"./package.json": "./package.json"
	}
}
